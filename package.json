{
  "name": "paper-crypto-investor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green 'pnpm --filter @paper-investor/server dev' 'pnpm --filter @paper-investor/web dev'",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.8"
  }
}
